# 仅供本地开发；复制为 .env 后设置自己的密码。
MYSQL_ROOT_PASSWORD=replace-with-a-local-password
MYSQL_PORT=13306
REDIS_PORT=16379
NACOS_CONSOLE_PORT=18880
# Nacos 客户端 gRPC 端口应等于服务端口 + 1000。
NACOS_PORT=8848
NACOS_GRPC_PORT=9848

# Nacos 本地示例：使用前请替换为自己的值；token 为至少 32 字节随机数的 Base64。
NACOS_AUTH_TOKEN=VGhpc0lzTXlDdXN0b21TZWNyZXRLZXkwMTIzNDU2Nzg=
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=replace-with-a-random-value
